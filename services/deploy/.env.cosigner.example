# ============================================================================
# Co-Signer Environment Variables (Server B)
# ============================================================================
# setup-cosigner.sh writes .env.cosigner from exported values; this lists what
# the service refuses to start without. NEVER commit .env.cosigner to git.
# ============================================================================

# Path to admin key 2 (.skey) — INSIDE the container (mapped via volume)
COSIGNER_SKEY_PATH=/app/keys/admin_2.skey

# Shared secret with Server A — must match COSIGNER_API_SECRET on Server A.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COSIGNER_API_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe

# admin_1's key hash: the other required signer of every surrender
COSIGNER_PRIMARY_ADMIN_PKH=

# Ledger of approvals, created once with
#   python -m services.redemption_ledger init /app/data/cosigned.sqlite3
COSIGNER_LEDGER_PATH=/app/data/cosigned.sqlite3

# This host's own view of the chain (a Blockfrost project on NETWORK)
BLOCKFROST_PROJECT_ID=

# The pool this co-signer guards
NETWORK=mainnet
SURRENDER_SCRIPT_ADDRESS=
QUARANTINE_ADDRESS=
CMATRA_POLICY_HEX=
CMATRA_ASSET_HEX=
SURRENDER_DEADLINE_POSIX_MS=
MAX_CMATRA_PER_TX=
MAX_CMATRA_PER_DAY=
