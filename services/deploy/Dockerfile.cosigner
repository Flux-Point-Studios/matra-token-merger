FROM python:3.12-slim

WORKDIR /app

# Exactly the versions CI tests, each checked against its hash.
COPY services/deploy/requirements-cosigner.txt /tmp/
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-cosigner.txt

# The co-signer prices surrenders with the same code and data the surrender
# API uses: the rational-rate helpers in tools/, the rate table and the
# redemption pin in audit_pack/.
COPY services/__init__.py services/cosigner_api.py services/cosign_policy.py services/chain_check.py services/redemption_ledger.py services/
COPY tools/__init__.py tools/config.py tools/api_clients.py tools/cardano_utils.py tools/process_surrender.py tools/
COPY audit_pack/2026-04-19/rate_table_cmatra.json audit_pack/2026-04-19/
COPY audit_pack/2026-09-27/redemption_pin.json audit_pack/2026-09-27/

EXPOSE 8421

CMD ["uvicorn", "services.cosigner_api:app", "--host", "0.0.0.0", "--port", "8421", "--log-level", "info"]
